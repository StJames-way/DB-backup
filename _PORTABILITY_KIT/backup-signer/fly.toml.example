app = "REPLACE_SIGNER_APP"
primary_region = "cdg"

[build]
  dockerfile = "Dockerfile"

[env]
  GITHUB_OIDC_ISSUER = "https://token.actions.githubusercontent.com"
  GITHUB_OIDC_AUDIENCE = "openbao://supabase-backup-signing"
  ALLOWED_REPOSITORY = "OWNER/REPO"
  ALLOWED_REPOSITORY_ID = "REPLACE_NUMERIC_ID"
  ALLOWED_REPOSITORY_OWNER_ID = "REPLACE_NUMERIC_OWNER_ID"
  ALLOWED_REF = "refs/heads/main"
  ALLOWED_EVENTS = "workflow_dispatch,repository_dispatch"
  ALLOWED_JOB_WORKFLOW_REF = "OWNER/REPO/.github/workflows/supabase-age-openbao-reusable.yml@REPLACE_40_CHAR_SHA"
  ALLOWED_CALLER_WORKFLOW_REF = "OWNER/REPO/.github/workflows/supabase-backup-dispatch.yml@refs/heads/main"
  OPENBAO_CA_FILE = "/etc/ssl/certs/openbao-ca.pem"
  OPENBAO_AUTH_MOUNT = "approle-backup"
  OPENBAO_TRANSIT_MOUNT = "transit-backup"
  OPENBAO_KEY_NAME = "REPLACE_TRANSIT_KEY"
  MAX_MANIFEST_BYTES = "262144"
  REQUEST_TIMEOUT_SECONDS = "10"
  JWT_LEEWAY_SECONDS = "30"

[http_service]
  internal_port = 8080
  force_https = false
  auto_stop_machines = "stop"
  auto_start_machines = true
  min_machines_running = 0
  processes = ["app"]

  [http_service.concurrency]
    type = "requests"
    soft_limit = 5
    hard_limit = 10

  [[http_service.checks]]
    interval = "30s"
    timeout = "5s"
    grace_period = "10s"
    method = "GET"
    path = "/readyz"

[[vm]]
  size = "shared-cpu-1x"
  memory = "256mb"
